@{
    ViewBag.Title = "Suma";
}

<h2>Calculadora</h2>

<div class="container">
    <div class="row">
        <div class="col-lg-6">
            <form method="post">

                <div class="mb-3">
                    <label for="num1" class="form-label">Número 1:</label>
                    <input type="text" class="form-control" id="x" name="x" required />
                </div>

                <div class="mb-3">
                    <label for="num2" class="form-label">Número 2:</label>
                    <input type="text" class="form-control" id="y" name="y" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Operación:</label><br />

                    <input type="radio" id="suma" name="r1" value="suma" checked />
                    <label for="suma">Suma</label><br />

                    <input type="radio" id="resta" name="r1" value="resta" />
                    <label for="resta">Resta</label>
                </div>

                <button type="submit" class="btn btn-primary">Calcular</button>
            </form>

            @if (ViewBag.Res != null)
            {
                <div class="alert alert-success mt-3">
                    Resultado: @ViewBag.Res
                </div>
            }
        </div>
    </div>
</div>